# ---- Convex ----
# Two ways to run the backend:
#
# (A) Convex Cloud (managed, metered free tier). Get these by running
#     `npx convex dev` — Convex creates a project and auto-populates .env.local.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
# Optional server-only override. Leave commented for local Vite dev; the server
# falls back to VITE_CONVEX_URL, and Convex CLI warns if both active URL vars exist.
# CONVEX_URL=
#
# (B) Self-hosted Convex in local Docker (unmetered). See LOCAL_STARTUP.md for
#     the one-time migration, then run `npm run start:local`. In this mode:
#       - leave CONVEX_DEPLOYMENT UNSET (the CLI refuses to mix cloud +
#         self-hosted config);
#       - point the app clients at the local backend:
#         VITE_CONVEX_URL=http://127.0.0.1:3210
#       - set the CLI's self-hosted target + admin key (admin key is generated
#         with `docker compose exec backend ./generate_admin_key.sh`):
# CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
# CONVEX_SELF_HOSTED_ADMIN_KEY=
#     Optional: pin the Docker image tags (default `latest`) for reproducibility.
#     See https://github.com/get-convex/convex-backend/releases
# CONVEX_BACKEND_TAG=
# CONVEX_DASHBOARD_TAG=
#     Optional: override the local backend/dashboard ports (defaults shown).
# CONVEX_BACKEND_PORT=3210
# CONVEX_SITE_PROXY_PORT=3211
# CONVEX_DASHBOARD_PORT=6791

# ---- Sendblue (iMessage bridge) ----
# Sign up at https://sendblue.com, get your API keys + provisioned number.
# Webhook URL you'll set in Sendblue dashboard:  <PUBLIC_URL>/sendblue/webhook
#
# SENDBLUE_FROM_NUMBER MUST be your Sendblue-provisioned number (the one
# people text TO), not your personal cell. Sendblue's API requires it.
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=

# ---- Agent runtime ----
# claude = Claude Agent SDK / Claude Code path. codex = local `codex app-server`
# path using the ChatGPT/Codex account from `codex login`.
BOOP_RUNTIME=claude

# ---- Claude model ----
# Uses your Claude Code subscription automatically — no separate API key needed.
# Override with ANTHROPIC_API_KEY if you want to bypass the subscription.
# This is the *fallback*; runtime overrides set via the iMessage set_model tool
# (stored in the Convex `settings` table) take precedence.
BOOP_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=

# ---- Codex model ----
# Used when BOOP_RUNTIME=codex or the runtime setting is switched to Codex.
# Requires `codex login` on the host. BOOP_CODEX_AUTH_HOME can point at another
# Codex home containing auth.json if needed.
BOOP_CODEX_MODEL=gpt-5.5
BOOP_CODEX_REASONING_EFFORT=medium
# BOOP_CODEX_AUTH_HOME=

# ---- Local browser use ----
# Patchright-backed Chrome profile for login-required services, visual browser
# workflows, and bot-wall-sensitive sites. Debug UI settings stored in Convex
# take precedence over these fallbacks. Off by default; enable in Settings
# before agents can see or use the local browser integration.
# BOOP_BROWSER_ENABLED=false
# BOOP_BROWSER_PROFILE_DIR=~/.boop/browser-profile
# BOOP_BROWSER_SHOW_UI=true
# BOOP_BROWSER_LOGIN_HANDOFF=false
# BOOP_BROWSER_START_URL=
# BOOP_BROWSER_CHANNEL=chrome
# BOOP_BROWSER_EXECUTABLE_PATH=
# BOOP_BROWSER_EXTRA_ARGS=

# ---- Apple data (optional) ----
# Read-only iMessage / Apple Notes / Apple Calendar / Apple Reminders / Voice
# Memos access on the local Mac. iMessage and Voice Memos require Full Disk
# Access for the terminal/Codex app running `npm run dev`. Apple Notes and Apple
# Reminders require macOS Automation permission. Calendar requires the optional
# Apple bridge.
# BOOP_APPLE_ENABLED=false
# BOOP_APPLE_MESSAGES_ENABLED=false
# BOOP_APPLE_NOTES_ENABLED=false
# BOOP_APPLE_REMINDERS_ENABLED=false
# BOOP_APPLE_VOICEMEMOS_ENABLED=false
# Voice Memo transcription runs locally via @huggingface/transformers (Whisper).
# Override the model (e.g. Xenova/whisper-tiny.en for speed):
# BOOP_VOICEMEMOS_WHISPER_MODEL=Xenova/whisper-base.en

# ---- Proactive email surfacing ----
# Phone number that receives proactive iMessage notices when the Gmail watcher
# decides an inbound email is worth surfacing. Single-user assumption for v1.
# Without this, the webhook still registers but notices are dropped.
BOOP_USER_PHONE=
# Set to "false" to skip auto-registering the Composio webhook URL on each
# `npm run dev`. Use when you want to manage the subscription manually.
# COMPOSIO_AUTO_WEBHOOK=

# ---- Upgrade notifications ----
# On `npm run dev`, Boop checks your `upstream` remote for new commits and
# prints a banner with the commit count + a reminder to run `/upgrade-boop`.
# Set to `false` to silence the check entirely.
# BOOP_UPSTREAM_CHECK=true

# ---- Embeddings (optional — paid providers for memory recall) ----
# Tried in order: Voyage → OpenAI → local Transformers.js (Xenova/bge-large-
# en-v1.5, 1024-dim, free, ~440MB one-time download). Leave both blank to
# use the local fallback. All three produce 1024-dim vectors so the Convex
# index stays compatible regardless of which is active.
# VOYAGE_API_KEY=
# OPENAI_API_KEY=

# ---- Personal wiki (optional — read-only Obsidian vault) ----
# Absolute path to a personal Obsidian/markdown vault. When set, Boop gets
# read-only wiki_search / wiki_read / wiki_index tools over it (the vault is
# the source of truth; Boop never writes to it). Leave blank to disable.
# WIKI_VAULT_PATH=/absolute/path/to/your/obsidian-vault
# Comma-separated, vault-relative subtrees to search. Default: "wiki".
# Add raw source folders (e.g. auto-ingested transcripts) here when you want
# them searchable, e.g. "wiki,raw/meetings".
# WIKI_SYNC_INCLUDE=wiki

# ---- ClickUp (optional — ticketing) ----
# A personal API token from ClickUp → Settings → Apps → API Token. Setting it
# enables the "clickup" integration: search/create/update tasks, comments, time
# tracking, and Docs. Boop talks to ClickUp's REST API directly rather than its
# hosted MCP, so the budget is ~100 requests/minute per token (not a daily
# tool-call cap). The token is shared by every client using it.
# CLICKUP_API_KEY=pk_00000000_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Workspace ("team") id — the number in your ClickUp URL. Optional: Boop
# resolves it automatically when the token can see exactly one workspace.
# CLICKUP_TEAM_ID=
# Default list for clickup_create_task when no list_id is passed. Find ids with
# the clickup_list_spaces tool. Strongly recommended — it lets Boop file a
# ticket in a single API call with no discovery round-trips.
# CLICKUP_DEFAULT_LIST_ID=

# ---- Server ----
PORT=3456

# Public URL for your server.
# - Leave as http://localhost:3456 if your tunnel URL rotates each restart
#   (Cloudflare quick tunnel — `cloudflared tunnel --url http://localhost:3456`
#   — or free ngrok).
# - Set to your stable public URL (e.g. https://boop.mydomain.com) if you use
#   a named Cloudflare Tunnel, a Caddy server, or any other tunnel with a
#   fixed URL — `npm run dev` will then skip ngrok.
PUBLIC_URL=http://localhost:3456

# Optional: named Cloudflare Tunnel to auto-start with `npm run dev`.
# Set to the tunnel name you created with `cloudflared tunnel create <name>`
# (needs a Cloudflare account + your own domain; gives a stable URL that
# survives restarts). Pair it with the matching stable PUBLIC_URL above.
# CLOUDFLARE_TUNNEL=

# Optional (ngrok alternative): ngrok RESERVED domain (paid plan). Example:
# "boop.ngrok.app". When set, `npm run dev` launches ngrok with
# --domain=$NGROK_DOMAIN so your public URL stays the same across restarts.
# NGROK_DOMAIN=

# When `npm run dev` manages a free-plan ngrok tunnel, it auto-registers the
# new tunnel URL with Sendblue as the inbound (receive) webhook so you don't
# have to paste it into the dashboard. Set to "false" to disable this.
# (Cloudflare quick tunnels aren't managed by `npm run dev` — register those
# with `npm run sendblue:webhook -- <url>` instead.)
# SENDBLUE_AUTO_WEBHOOK=true

# ---- Composio (1000+ integrations, zero-code) ----
# Get an API key at https://app.composio.dev/developers.
# Once set, connect toolkits (Gmail, Slack, GitHub, Linear, …) from the
# Debug UI's Connections tab. Each connected toolkit becomes available to
# the agent via spawn_agent(integrations: [...]).
COMPOSIO_API_KEY=

# Optional: stable user id Composio keys connections under. Defaults to
# "boop-default". Override only if you already manage Composio sessions
# elsewhere and want Boop to reuse that user.
# COMPOSIO_USER_ID=

# --- Image retention (optional) ---
# Days to keep iMessage-received image bytes. Images referenced by a
# memory record are kept indefinitely regardless of this setting.
# Set to 0 to disable cleanup (debug only).
BOOP_IMAGE_RETENTION_DAYS=3
BOOP_IMAGE_CLEANUP_INTERVAL_MS=43200000
